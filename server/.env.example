PORT=3001
DATABASE_URL=postgres://noxro:motdepasse@localhost:5432/noxro
# Dossier où sont stockés les documents envoyés
UPLOAD_DIR=./uploads
# true derrière nginx/HTTPS : cookies "secure" + trust proxy
PRODUCTION=false
# Origine du front en dev (CORS inutile si le front passe par le proxy Vite)
# Origines du front autorisées pour les écritures (si le Host ne correspond pas : proxy de dev...)
ALLOWED_ORIGINS=http://localhost:5173

# Clé API auto.dev (https://www.auto.dev) pour décoder le modèle et l'année d'un VIN. Facultatif.
AUTODEV_API_KEY=
