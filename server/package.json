{
  "name": "noxro-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node --env-file=.env src/index.js",
    "migrate": "node --env-file=.env scripts/migrate.js",
    "create-admin": "node --env-file=.env scripts/create-admin.js",
    "invite": "node --env-file=.env scripts/invite.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
